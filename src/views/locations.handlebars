<!-- ================= PAGE TITLE ================= -->
<section class="py-5 text-center">
    <div class="container">
        <h2 class="fw-bold">Location Details</h2>
    </div>
</section>
<!-- ================ END PAGE TITLE ================= -->

<!-- ================= LOCATIONS INFO ================= -->

<section id="locations" class="py-5 bg-light">
    <div class="container">
        <h2 class="text-center fw-bold mb-5">Our Locations</h2>
        <div class="row" id="location-cards">
            {{#each locations}}
            
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body text-center">
                            <img src="{{this.image}}" alt="{{this.name}}" class="img-fluid mb-4" />
                            <h5 class="card-title">{{this.name}}</h5>
                            <p class="card-text">{{this.region}}</p>
                            <p class="card-text">{{this.description}}</p>
                            <a href="/locations/{{this._id}}" class="btn btn-primary">View location</a>
                        </div>
                    </div>
                </div>
            
            {{/each}}
        </div>
    </div>
</section>


<!-- ================= END LOCATIONS INFO ================= -->